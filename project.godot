; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="AutoFollow"
run/main_scene="uid://d27dokc5yvhte"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

MCPRuntimeProbe="*res://addons/godot_mcp/runtime/mcp_runtime_probe.gd"

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="AutoFollow"

[editor_plugins]

enabled=PackedStringArray("res://addons/expose_check/plugin.cfg", "res://addons/godot_mcp/plugin.cfg", "res://addons/godot_rl_agents/plugin.cfg")

[global_group]

destinations="乘客的目的地"
vehicle_spawners=""
passenger_spawners=""
AIVehicleCam=""
AIParameter=""

